# replicant.env - Template
# Copy this file to each replicant branch and remove the BEADS_DOLT_PASSWORD line.
# The password lives ONLY in .env (gitignored, never committed).
# This file IS committed - it must be safe to source (no placeholders, no secrets).
#
# This file is sourced by .github/hooks/session-start.sh and session-end.sh.

BEADS_DIR="$HOME/.copilot-bridge/workspaces/<name>/.beads"
BEADS_ACTOR="<name>"
BEADS_DOLT_USER="<name>"
